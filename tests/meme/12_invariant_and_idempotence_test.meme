use ../../ast
use ../../stmt
use ../../emit

function get_root_path(filename: String) -> String:
    if file exists filename:
        return filename
    return "../../" + filename

function get_example_path(filename: String) -> String:
    if file exists "examples/" + filename:
        return "examples/" + filename
    return "../../examples/" + filename

function get_tmp_dir() -> String:
    if file exists "main.meme":
        return "tests/tmp"
    return "../tmp"

function verify_file_invariant(path: String) -> Void:
    define content_opt: Optional<String> as read string from file path or else nothing
    assert content_opt is not nothing
    define src: String as value of content_opt
    define t1_opt: Optional<Node> as parse_source(src)
    assert t1_opt is not nothing
    define t1: Node as value of t1_opt

    define em1: String as emit_program(t1)
    define t2_opt: Optional<Node> as parse_source(em1 + "\n")
    assert t2_opt is not nothing
    define t2: Node as value of t2_opt

    define diff_msg: String as tree_diff(t1, t2, "root")
    assert length of string diff_msg == 0
    assert trees_equal(t1, t2)

    define em2: String as emit_program(t2)
    assert em1 == em2

test repo_files_self_emit_invariant_test:
    call verify_file_invariant(get_root_path("main.meme"))
    call verify_file_invariant(get_root_path("ast.meme"))
    call verify_file_invariant(get_root_path("stmt.meme"))
    call verify_file_invariant(get_root_path("expr.meme"))
    call verify_file_invariant(get_root_path("keywords.meme"))
    call verify_file_invariant(get_root_path("lexer.meme"))
    call verify_file_invariant(get_root_path("emit.meme"))

test real_examples_invariant_in_tmp_test:
    define tmp_dir: String as get_tmp_dir()
    create directory tmp_dir

    define f512_src: Optional<String> as read string from file get_example_path("512_cli_argument_router.meme") or else nothing
    assert f512_src is not nothing
    define p512: String as tmp_dir + "/512.meme"
    write file p512 with value of f512_src
    call verify_file_invariant(p512)
    delete file p512

    define f538_src: Optional<String> as read string from file get_example_path("538_recursive_optional.meme") or else nothing
    assert f538_src is not nothing
    define p538: String as tmp_dir + "/538.meme"
    write file p538 with value of f538_src
    call verify_file_invariant(p538)
    delete file p538

    define f539_src: Optional<String> as read string from file get_example_path("539_json_record_collections.meme") or else nothing
    assert f539_src is not nothing
    define p539: String as tmp_dir + "/539.meme"
    write file p539 with value of f539_src
    call verify_file_invariant(p539)
    delete file p539

    define f541_src: Optional<String> as read string from file get_example_path("541_sha256.meme") or else nothing
    assert f541_src is not nothing
    define p541: String as tmp_dir + "/541.meme"
    write file p541 with value of f541_src
    call verify_file_invariant(p541)
    delete file p541

test emit_output_file_test:
    define tmp_dir: String as get_tmp_dir()
    create directory tmp_dir
    define src: String as "record Point:\n    x: Int\n"
    define opt: Optional<Node> as parse_source(src)
    assert opt is not nothing
    define em: String as emit_program(value of opt)
    define out_file: String as tmp_dir + "/out_point.meme"
    write file out_file with (em + "\n")
    assert file exists out_file
    define read_back: Optional<String> as read string from file out_file or else nothing
    assert read_back is not nothing
    assert value of read_back == (em + "\n")
    delete file out_file
