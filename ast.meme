# ast.meme - AST node model, tree emission, and node helpers

record Node:
    kind: String
    value: String
    line: Int
    child: Optional<Node>
    children: List<Node>

function make_leaf(kind: String, value: String, line: Int) -> Node:
    define empty_children: List<Node> as empty List<Node>
    return Node(kind=kind, value=value, line=line, child=nothing, children=empty_children)

function make_node(kind: String, value: String, line: Int, child: Optional<Node>, children: List<Node>) -> Node:
    return Node(kind=kind, value=value, line=line, child=child, children=children)

function make_wrapper(kind: String, value: String, line: Int, child: Node) -> Node:
    define empty_children: List<Node> as empty List<Node>
    return Node(kind=kind, value=value, line=line, child=optional child, children=empty_children)

function make_block(kind: String, value: String, line: Int, children: List<Node>) -> Node:
    return Node(kind=kind, value=value, line=line, child=nothing, children=children)

function make_opaque(value: String, line: Int) -> Node:
    define empty_children: List<Node> as empty List<Node>
    return Node(kind="opaque", value=value, line=line, child=nothing, children=empty_children)

function indent_spaces(level: Int) -> String:
    define res: String as ""
    for i from 1 to level:
        set res to res + "  "
    return res

function node_to_string(node: Node, level: Int) -> String:
    define ind: String as indent_spaces(level)
    define out: String as ind + node.kind
    if length of string node.value > 0:
        set out to out + " " + node.value
    set out to out + "\n"
    if node.child is not nothing:
        define ch: Node as value of node.child
        set out to out + node_to_string(ch, level + 1)
    for each c in node.children:
        set out to out + node_to_string(c, level + 1)
    return out

function emit_tree_text(node: Node) -> Void:
    define text: String as node_to_string(node, 0)
    print text

function count_opaque_nodes(node: Node) -> Int:
    define count: Int as 0
    if node.kind == "opaque":
        set count to count + 1
    if node.child is not nothing:
        define ch: Node as value of node.child
        set count to count + count_opaque_nodes(ch)
    for each c in node.children:
        set count to count + count_opaque_nodes(c)
    return count
